# Copy this file to .env for local development.
# On Render, add these as Environment Variables instead of committing .env.

APP_NAME=LavaLust Product API
APP_KEY=change-this-app-key
APP_ENV=development
APP_URL=http://127.0.0.1:3000

# Aiven MySQL
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# API / JWT
JWT_SECRET=dev-only-jwt-secret-change-this-before-deploy-123456
REFRESH_TOKEN_KEY=dev-only-refresh-key-change-this-before-deploy-123456
JWT_ISSUER=lavalust-product-api
JWT_AUDIENCE=product-management-frontend
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# Demo account inserted only when the users table is empty.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123
